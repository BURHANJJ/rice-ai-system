# Dependencies and build output
node_modules/
dist/
dist-ssr/
build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
**/android/.gradle/
**/android/local.properties
**/android/app/release/
__pycache__/
*.pyc
.venv/
venv/

# Local databases and runtime data
*.db
*.db-journal
*.db-wal
*.db-shm

# Secrets and per-deployment config: never commit these (templates live next to them as *.example)
.env
.env.*
!.env.example
serviceAccountKey*.json
*service-account*.json
*-adminsdk-*.json
kaggle.json
*.keystore
*.jks
key.properties
mobile/lib/firebase_options.dart
mobile/firebase.json
mobile/android/app/google-services.json
mobile/ios/Runner/GoogleService-Info.plist

# Release binaries are published on GitHub Releases, not in the repo
*.apk
*.aab
web/public/downloads/*.apk

# Project report and presentation media are kept out of the repository
/docs/report/
/video/
/web/public/media/
/output/
/*.pdf
/*.docx
/*.mp4
/*.webm

# Editor, OS and tool caches
.idea/
.vscode/*
!.vscode/extensions.json
.github/modernize/
.firebase/
.DS_Store
Thumbs.db
*.log

# Superseded model versions: kept locally, not in the repository
ai-service/model/*.v1.keras
ai-service/model/*.v2.keras
ai-service/model/*.h5

# Comparison-model weights are large (~1 GB in total); keep metrics, logs and histories only.
# Rebuild them with ai-service/model-comparison/train.py
ai-service/model-comparison/models/**/*.keras
ai-service/model-comparison/models/**/*.tflite

# Backups and leftovers
*.old
*.bak
*.orig
