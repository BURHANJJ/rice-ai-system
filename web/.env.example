# Copy to .env.local and fill in. Firebase console -> Project settings -> General -> Your apps -> Web app -> SDK setup and configuration.
# These identify your Firebase project and end up in the built site, so they are not secrets; keep them out of git anyway
# (.env.local is ignored) so a fork never points at somebody else's project by accident.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MEASUREMENT_ID=

# Khao Hom chat: leave empty to answer from the built-in knowledge base (free, works offline).
# For Claude-backed answers deploy the `chat` function (see functions/index.js) and set its URL, e.g.
# VITE_CHAT_URL=https://asia-southeast1-<your-project>.cloudfunctions.net/chat
VITE_CHAT_URL=
