# Normalize line endings for text; binaries below override this
* text=auto
*.sh text eol=lf
*.bat text eol=crlf

# Model files are committed as ordinary binaries (no Git LFS), so a plain clone or a ZIP download works
*.keras binary
*.tflite binary
*.onnx binary
*.h5 binary

# Notebooks hold large saved outputs; keep them out of the repository language statistics
*.ipynb linguist-detectable=false
